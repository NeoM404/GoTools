<mxfile host="nedctl"><diagram name="08-code-architecture"><mxGraphModel dx="1760" dy="940" grid="0" page="1" pageWidth="1760" pageHeight="940" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="bg" value="" style="rounded=0;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1760" height="940" as="geometry"/></mxCell><mxCell id="n1" value="Inside nedctl — layered Go packages, one boundary to the outside world" style="text;html=1;whiteSpace=wrap;fontSize=24;fontColor=#232F3E;fontStyle=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1600" height="36" as="geometry"/></mxCell><mxCell id="n2" value="Commands compose small, pure, tested packages. Every subprocess goes through execx (deadline, cancellation, process group); every HTTPS call enforces TLS 1.2+ and refuses downgrades." style="text;html=1;whiteSpace=wrap;fontSize=15;fontColor=#5A6B7B;fontStyle=0;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="62" width="1680" height="30" as="geometry"/></mxCell><mxCell id="n3" value="&lt;b&gt;cmd/nedctl&lt;/b&gt; — main: signals → context, exit code" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#0F1B2D;strokeColor=#0F1B2D;fontSize=14;fontColor=#FFFFFF;fontStyle=0;align=center;verticalAlign=middle;spacing=8;dashed=0;" vertex="1" parent="1"><mxGeometry x="60" y="120" width="1640" height="54" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b&gt;internal/app&lt;/b&gt; — dispatch + commands, injected I/O, exit-code contract&lt;br&gt;aws · shell · ec2 · connect · eks · prompt · login/kubeconfig · guard/current · inventory · fleet · sweep · audit · evidence · init · doctor" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F5FD0;fontSize=14;fontColor=#232F3E;fontStyle=0;align=center;verticalAlign=middle;spacing=8;dashed=0;" vertex="1" parent="1"><mxGeometry x="60" y="196" width="1640" height="80" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;awssso&lt;/b&gt;&lt;br&gt;Identity Center portal,&lt;br&gt;token cache, managed profiles" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA5B4;fontSize=13;fontColor=#232F3E;fontStyle=0;align=center;verticalAlign=middle;spacing=8;dashed=0;" vertex="1" parent="1"><mxGeometry x="60" y="306" width="256" height="100" as="geometry"/></mxCell><mxCell id="n6" value="&lt;b&gt;picker&lt;/b&gt;&lt;br&gt;type-to-filter chooser,&lt;br&gt;no raw mode" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA5B4;fontSize=13;fontColor=#232F3E;fontStyle=0;align=center;verticalAlign=middle;spacing=8;dashed=0;" vertex="1" parent="1"><mxGeometry x="336" y="306" width="256" height="100" as="geometry"/></mxCell><mxCell id="n7" value="&lt;b&gt;kube&lt;/b&gt;&lt;br&gt;classify, resolve, bastion&lt;br&gt;contexts, sweep" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA5B4;fontSize=13;fontColor=#232F3E;fontStyle=0;align=center;verticalAlign=middle;spacing=8;dashed=0;" vertex="1" parent="1"><mxGeometry x="612" y="306" width="256" height="100" as="geometry"/></mxCell><mxCell id="n8" value="&lt;b&gt;inventory&lt;/b&gt;&lt;br&gt;fleet model, validation,&lt;br&gt;HTTPS + cache" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA5B4;fontSize=13;fontColor=#232F3E;fontStyle=0;align=center;verticalAlign=middle;spacing=8;dashed=0;" vertex="1" parent="1"><mxGeometry x="888" y="306" width="256" height="100" as="geometry"/></mxCell><mxCell id="n9" value="&lt;b&gt;discovery&lt;/b&gt;&lt;br&gt;EKS/AKS scan, bounded,&lt;br&gt;all-or-nothing scopes" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA5B4;fontSize=13;fontColor=#232F3E;fontStyle=0;align=center;verticalAlign=middle;spacing=8;dashed=0;" vertex="1" parent="1"><mxGeometry x="1164" y="306" width="256" height="100" as="geometry"/></mxCell