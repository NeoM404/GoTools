<mxfile host="nedctl"><diagram name="02-aws-sign-in"><mxGraphModel dx="1760" dy="880" grid="0" page="1" pageWidth="1760" pageHeight="880" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="bg" value="" style="rounded=0;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1760" height="880" as="geometry"/></mxCell><mxCell id="n1" value="aws login — one sign-in, one account and role, no keys handled" style="text;html=1;whiteSpace=wrap;fontSize=24;fontColor=#232F3E;fontStyle=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1600" height="36" as="geometry"/></mxCell><mxCell id="n2" value="nedctl drives the AWS CLI&#x27;s own Identity Center flow, lists only your assignments, and writes one profile; the AWS CLI fetches credentials on first use." style="text;html=1;whiteSpace=wrap;fontSize=15;fontColor=#5A6B7B;fontStyle=0;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="62" width="1680" height="30" as="geometry"/></mxCell><mxCell id="n3" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#D5DBE5;fontSize=14;fontColor=#232F3E;fontStyle=0;align=center;verticalAlign=middle;spacing=8;dashed=0;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="1680" height="220" as="geometry"/></mxCell><mxCell id="n4" value="Engineer machine — nedctl" style="text;html=1;whiteSpace=wrap;fontSize=15;fontColor=#232F3E;fontStyle=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="60" y="120" width="600" height="24" as="geometry"/></mxCell><mxCell id="n5" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF6F7;strokeColor=#D5DBE5;fontSize=14;fontColor=#232F3E;fontStyle=0;align=center;verticalAlign=middle;spacing=8;dashed=0;" vertex="1" parent="1"><mxGeometry x="40" y="400" width="1680" height="260" as="geometry"/></mxCell><mxCell id="n6" value="AWS — IAM Identity Center and STS" style="