ntryDy=0;" edge="1" parent="1" source="n11" target="n12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n24" value="stdout carries only  &lt;font face=&#x27;monospace&#x27;&gt;export AWS_PROFILE=&#x27;nedctl.payments-prod.Platform-ReadOnly&#x27;&lt;/font&gt;  — so  eval &quot;$(nedctl aws login)&quot;  works; the picker runs on stderr." style="text;html=1;whiteSpace=wrap;fontSize=14;fontColor=#232F3E;fontStyle=0;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="70" y="700" width="1600" height="30" as="geometry"/></mxCell><mxCell id="n25" value="Never: an access key in a clipboard · the token on a command line · the token written to disk by nedctl · a sign-in to every account (except break-glass)" style="text;html=1;whiteSpace=wrap;fontSize=14;fontColor=#C53030;fontStyle=0;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="70" y="738" width="1600" height="30" as="geometry"/></mxCell><mxCell id="n26" value="IAM Identity Center&lt;br&gt;OIDC sign-in" style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=14;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.single_sign_on;" vertex="1" parent="1"><mxGeometry x="433" y="480" width="64" height="64" as="geometry"/></mxCell><mxCell id="n27" value="Portal API&lt;br&gt;ListAccounts · ListAccountRoles" style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=14;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.single_sign_on;" vertex="1" parent="1"><mxGeometry x="713" y="480" width="64" height="64" as="geometry"/></mxCell><mxCell id="n28" value="GetRoleCredentials&lt;br&gt;by the AWS CLI, on first use" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientC