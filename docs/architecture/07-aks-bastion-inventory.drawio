0;entryDy=0;" edge="1" parent="1" source="n6" target="n13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n22" value="Bastion network (no internet)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#5A6B7B;strokeWidth=2;dashed=0;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=15;fontStyle=1;fontColor=#5A6B7B;" vertex="1" parent="1"><mxGeometry x="40" y="540" width="1680" height="360" as="geometry"/></mxCell><mxCell id="n23" value="AKS bastion (RHEL)" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=14;verticalLabelPosition=bottom;verticalAlign=top;fontColor=#232F3E;image=img/lib/azure2/compute/Virtual_Machine.svg;" vertex="1" parent="1"><mxGeometry x="120" y="640" width="72" height="72" as="geometry"/></mxCell><mxCell id="n24" value="&lt;b&gt;nedctl — mode &quot;bastion&quot;&lt;/b&gt;&lt;br&gt;login &amp;lt;cluster&amp;gt; → kubectl config use-context&lt;br&gt;guard · current · prompt · fleet versions&lt;br&gt;no az, no credentials fetched" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F5FD0;fontSize=13;fontColor=#232F3E;fontStyle=0;align=left;verticalAlign=middle;spacing=8;dashed=0;" vertex="1" parent="1"><mxGeometry x="300" y="610" width="460" height="130" as="geometry"/></mxCell><mxCell id="n25" value="&lt;b&gt;Provisioned kubeconfig&lt;/b&gt;&lt;br&gt;contexts &lt;i&gt;&amp;lt;app&amp;gt;-k8s-&amp;lt;env&amp;gt;-cluster&lt;/i&gt;&lt;br&gt;users &lt;i&gt;clusterUser_&amp;lt;rg&amp;gt;_&amp;lt;cluster&amp;gt;&lt;/i&gt; (static local accounts)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA5B4;fontSize=13;fontColor=#232F3E;fontStyle=0;align=left;verticalAlign=middle;spacing=8;dashed=0;" vertex="1" parent="1"><mxGeometry x="830" y="610" width="460" height="110" as="geometry"/></mxCell><mxCell id="n26" value="&lt;b&gt;Recorded per person&lt;/b&gt;: the Linux user who ran login, the context and its kubeconfig user; shared local accounts are flagged — the cluster audit log cannot tell people apart. Fix: Entra ID + kubelogin." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#C53030;fontSize=13;fontColor=#232F3E;fontStyle=0;align=left;verticalAlign=middle;spacing=8;dashed=0;" vertex="1" parent="1"><mxGeometry x="830" y="760" width="820" height="100" as="geometry"/></mxCell><mxCell id="n27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#5A6B7B;fontSize=13;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;dashed=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n23" target="n24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#5A6B7B;fontSize=13;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;dashed=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n24" target="n25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n29" value="fleet.json — delivery path is the team&#x27;s choice" style="text;html=1;whiteSpace=wrap;fontSize=13;fontColor=#5A6B7B;fontStyle=0;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="350" y="505" width="420" height="24" as="geometry"/></mxCell><mxCell id="n30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#5A6B7B;fontSize=13;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0.85;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n5" target="n23"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="335" y="610"/><mxPoint x="156" y="610"/></Array></mxGeometry></mxCell><mxCell id="n31" value="kubectl" style="edgeStyle=orthogona