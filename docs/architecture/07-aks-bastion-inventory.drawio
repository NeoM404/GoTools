<mxfile host="nedctl"><diagram name="07-aks-bastion-inventory"><mxGraphModel dx="1760" dy="930" grid="0" page="1" pageWidth="1760" pageHeight="930" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="bg" value="" style="rounded=0;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1760" height="930" as="geometry"/></mxCell><mxCell id="n1" value="AKS — inventory built in Azure DevOps, used on air-gapped bastions" style="text;html=1;whiteSpace=wrap;fontSize=24;fontColor=#232F3E;fontStyle=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1600" height="36" as="geometry"/></mxCell><mxCell id="n2" value="Cloud discovery runs in a read-only pipeline, never on the bastion. A person merges the proposal; CI validates it; bastions get the reviewed fleet.json." style="text;html=1;whiteSpace=wrap;fontSize=15;fontColor=#5A6B7B;fontStyle=0;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="62" width="1680" height="30" as="geometry"/></mxCell><mxCell id="n3" value="Azure DevOps" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#0078D4;strokeWidth=2;dashed=0;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=15;fontStyle=1;fontColor=#0078D4;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="1000" height="380" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b&gt;Repo&lt;/b&gt; — inventory/fleet.json&lt;br&gt;the reviewed record (changes only by PR)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA5B4;fontSize=13;fontColor=#232F3E;fontStyle=0;align=center;verticalAlign=middle;spacing=8;dashed=0;" vertex="1" parent="1"><mxGeometry x="80" y="170" width="300" height="90" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;CI pipeline&lt;/b&gt; — validate on every PR&lt;br&gt;publish the &lt;i&gt;fleet&lt;/i&gt; artifact on main" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA5B4;fontSize=13;fontColor=#232F3E;fontStyle=0;align=center;verticalAlign=middle;spacing=8;dashed=0;" vertex="1" parent="1"><mxGeometry x="80" y="330" width="300" height="90" as="geometry"/></mxCell><mxCell id="n6" value="&lt;b&gt;Nightly pipeline&lt;/b&gt; — AzureCLI@2, service connection with Reader&lt;br&gt;nedctl inventory diff · sync" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F5FD0;fontSize=13;fontColor=#232F3E;fontStyle=0;align=center;verticalAlign=middle;spacing=8;dashed=0;" vertex="1" parent="1"><mxGeometry x="470" y="170" width="360" height="100" as="geometry"/></mxCell><mxCell id="n7" value="&lt;b&gt;diff.json · proposed-fleet.json&lt;/b&gt;&lt;br&gt;red run when reality differs" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF8EE;strokeColor=#F08A24;fontSize=13;fontColor=#232F3E;fontStyle=0;align=center;verticalAlign=middle;spacing=8;dashed=0;" vertex="1" parent="1"><mxGeometry x="470" y="330" width="360" height="90" as="geometry"/></mxCell><mxCell id="n8" value="" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=14;verticalLabelPosition=bottom;verticalAlign=top;fontColor=#232F3E;image=img/lib/azure2/devops/Azure_DevOps.svg;" vertex="1" parent="1"><mxGeometry x="930" y="380" width="72" height="72" as="geometry"/></mxCell><mxCell id="n9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#F08A24;fontSize=13;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;dashed=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n6" target="n7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n10" value="a person reviews + merges" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#5A6B7B;fontSize=13;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0;exit