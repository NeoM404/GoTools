<mxfile host="bankctl"><diagram name="06-audit-evidence"><mxGraphModel dx="1760" dy="900" grid="0" page="1" pageWidth="1760" pageHeight="900" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="bg" value="" style="rounded=0;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1760" height="900" as="geometry"/></mxCell><mxCell id="n1" value="Audit trail and evidence — recorded before it happens, provable after" style="text;html=1;whiteSpace=wrap;fontSize=24;fontColor=#232F3E;fontStyle=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1600" height="36" as="geometry"/></mxCell><mxCell id="n2" value="Every access writes a start event before acting (no record, no access) and an end event with the outcome. The chain is tamper-evident; the SIEM gets a copy; evidence packs come from it." style="text;html=1;whiteSpace=wrap;fontSize=15;fontColor=#5A6B7B;fontStyle=0;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="62" width="1680" height="30" as="geometry"/></mxCell><mxCell id="n3" value="&lt;b&gt;Command&lt;/b&gt;&lt;br&gt;aws login · shell · connect&lt;br&gt;login · env · ec2" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA5B4;fontSize=13;fontColor=#232F3E;fontStyle=0;align=center;verticalAlign=middle;spacing=8;dashed=0;" vertex="1" parent="1"><mxGeometry x="60" y="150" width="290" height="96" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b&gt;Start event&lt;/b&gt;&lt;br&gt;who · where · what · change record&lt;br&gt;prevHash → hash" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F5FD0;fontSize=13;fontColor=#232F3E;fontStyle=0;align=center;verticalAlign=middle;spacing=8;dashed=0;" vertex="1" parent="1"><mxGeometry x="395" y="150" width="290" height="96" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;Change control&lt;/b&gt;&lt;br&gt;required? verified? break-glass?&lt;br&gt;(switchable)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA5B4;fontSize=13;fontColor=#232F3E;fontStyle=0;align=center;verticalAlign=middle;spacing=8;dashed=0;" vertex="1" parent="1"><mxGeometry x="730" y="150" width="290" height="96" as="geometry"/></mxCell><mxCell id="n6" value="&lt;b&gt;Action&lt;/b&gt;&lt;br&gt;SSO profile · SSM session&lt;br&gt;tunnel · credentials" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA5B4;fontSize=13;fontColor=#232F3E;fontStyle=0;align=center;verticalAlign=middle;spacing=8;dashed=0;" vertex="1" parent="1"><mxGeometry x="1065" y="150" width="290" height="96" as="geometry"/></mxCell><mxCell id="n7" value="&lt;b&gt;End event&lt;/b&gt;&lt;br&gt;outcome · acting principal&lt;br&gt;detail" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F5FD0;fontSize=13;fontColor=#232F3E;fontStyle=0;align=center;verticalAlign=middle;spacing=8;dashed=0;" vertex="1" parent="1"><mxGeometry x="1400" y="150" width="290" height="96" as="geometry"/></mxCell><mxCell id="n8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#5A6B7B;fontSize=13;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;dashed=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n3" target="n4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#5A6B7B;fontSize=13;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;dashed=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n4" target="n5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#5A6B7B;fontSize=13;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;dashed=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n5" target="n6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#5A6B7B;fontSize=13;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;dashed=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n6" target="n7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n12" value="Cannot write the start event → the action does not happen" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#C53030;fontSize=13;fontColor=#232F3E;fontStyle=0;align=center;verticalAlign=middle;spacing=8;dashed=0;" vertex="1" parent="1"><mxGeometry x="395" y="290" width="290" height="60" as="geometry"/></mxCell><mxCell id="n13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#C53030;fontSize=13;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;dashed=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n4" target="n12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n14" value="&lt;b&gt;audit.jsonl&lt;/b&gt; — local, 0600, file-locked&lt;br&gt;each event&#x27;s hash covers the previous one&lt;br&gt;&lt;font face=&#x27;monospace&#x27;&gt;bankctl audit verify&lt;/font&gt; detects edits, inserts, deletions" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF8EE;strokeColor=#F08A24;fontSize=13;fontColor=#232F3E;fontStyle=0;align=left;verticalAlign=middle;spacing=8;dashed=0;" vertex="1" parent="1"><mxGeometry x="60" y="420" width="520" height="110" as="geometry"/></mxCell><mxCell id="n15" value="&lt;b&gt;SIEM&lt;/b&gt; — Splunk HEC or JSON&lt;br&gt;best effort; the local log stays authoritative" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA5B4;fontSize=13;fontColor=#232F3E;fontStyle=0;align=left;verticalAlign=middle;spacing=8;dashed=0;" vertex="1" parent="1"><mxGeometry x="700" y="420" width="420" height="110" as="geometry"/></mxCell><mxCell id="n16" value="&lt;b&gt;bankctl evidence --period 2026-Q4&lt;/b&gt;&lt;br&gt;pack for auditors + SHA-256&lt;br&gt;exceptions: break-glass · prod without a change record · unverified records · incomplete sessions" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F5FD0;fontSize=13;fontColor=#232F3E;fontStyle=0;align=left;verticalAlign=middle;spacing=8;dashed=0;" vertex="1" parent="1"><mxGeometry x="1240" y="420" width="460" height="130" as="geometry"/></mxCell><mxCell id="n17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#F08A24;fontSize=13;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;dashed=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.2;entryDx=0;entryDy=0;" edge="1" parent="1" source="n7" target="n14"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1485" y="380"/><mxPoint x="640" y="380"/><mxPoint x="640" y="442"/></Array></mxGeometry></mxCell><mxCell id="n18" value="forward" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#F08A24;fontSize=13;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;dashed=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n14" target="n15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#5A6B7B;fontSize=13;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n15" target="n16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n20" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF6F7;strokeColor=#D5DBE5;fontSize=14;fontColor=#232F3E;fontStyle=0;align=center;verticalAlign=middle;spacing=8;dashed=0;" vertex="1" parent="1"><mxGeometry x="40" y="600" width="1680" height="260" as="geometry"/></mxCell><mxCell id="n21" value="Authoritative cloud records — bankctl makes them name a person" style="text;html=1;whiteSpace=wrap;fontSize=15;fontColor=#232F3E;fontStyle=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="60" y="610" width="600" height="24" as="geometry"/></mxCell><mxCell id="n22" value="CloudTrail&lt;br&gt;sign-ins, StartSession" style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=14;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudtrail;" vertex="1" parent="1"><mxGeometry x="180" y="680" width="64" height="64" as="geometry"/></mxCell><mxCell id="n23" value="Session Manager logs&lt;br&gt;commands run (requested)" style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=14;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudwatch_2;" vertex="1" parent="1"><mxGeometry x="600" y="680" width="64" height="64" as="geometry"/></mxCell><mxCell id="n24" value="EKS audit log&lt;br&gt;API calls by role session" style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=14;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.eks;" vertex="1" parent="1"><mxGeometry x="1020" y="680" width="64" height="64" as="geometry"/></mxCell><mxCell id="n25" value="The bankctl trail is attribution of intent from a client; these are the record of what reached the cloud." style="text;html=1;whiteSpace=wrap;fontSize=14;fontColor=#232F3E;fontStyle=0;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1250" y="690" width="430" height="80" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>